pipeline {
    agent any

    environment {
        COMPOSE_DIR = 'reactjs-todo-app/reactjs-todo-app'   // adjust to your actual repo path
    }

    stages {
        stage('build') {
            steps {
                sh 'touch demo.py'
            }
        }

        stage('test') {
            steps {
                sh 'python3 test.py'
            }
        }

        stage('Docker Compose Up') {
            steps {
                dir("${COMPOSE_DIR}") {
                    sh 'docker compose up -d --build'
                }
            }
        }
    }
}
