
pipeline {
    agent { label 'agent-node' }

    environment {
        IMAGE_NAME = 'test'
        IMAGE_TAG = 'v1'
        CONTAINER_NAME = 'myapp'
        HOST_PORT = '8082'
    }

    stages {
        stage('build') {
            steps {
                sh 'touch demo.py'
            }
        }

        stage('test') {
            steps {
                sh 'python3 test.py'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -f reactjs-todo-app/reactjs-todo-app/Dockerfile reactjs-todo-app/reactjs-todo-app'
            }
        }

        stage('Docker Run') {
            steps {
                sh '''
                    docker stop ${CONTAINER_NAME} || true
                    docker rm ${CONTAINER_NAME} || true
                    docker run -d --name ${CONTAINER_NAME} -p ${HOST_PORT}:80 ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }
    }
}
